# Required: Google AI Studio API key (for Gemini 2.5 Flash planner + Gemini Omni 1.2 Flash video)
GEMINI_API_KEY=

# Optional until ready to auto-post: TikTok for Developers OAuth credentials
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3456/auth/tiktok/callback

# Posting privacy: SELF_ONLY works immediately (Draft/Private).
# Switch to PUBLIC_TO_EVERYONE only after your TikTok app passes TikTok Audit.
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Content & schedule defaults (can also be edited in the Web UI)
CONTENT_NICHE=เรื่องเล่าสั้นๆ สุดลึกลับและน่าทึ่งในประวัติศาสตร์
CONTENT_LANGUAGE=th
TARGET_DURATION_SEC=150
SCENE_DURATION_SEC=15
VIDEO_RESOLUTION=720p
DAILY_POST_TIME=09:00
SCHEDULER_ENABLED=false
PORT=3456
DRY_RUN=false
